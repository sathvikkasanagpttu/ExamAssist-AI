# ExamAssist AI Backend Configuration Example
PORT=8787
NODE_ENV=development

# OpenAI API Key (Required for AI features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Web Search Provider Keys (Optional: Tavily, Serper, or Brave)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:8787,chrome-extension://*
RATE_LIMIT_PER_MINUTE=120
