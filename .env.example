# ExamAssist AI Backend Configuration Example
PORT=8787
NODE_ENV=development

# OpenAI API Key (Required for AI features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Web Search Provider Keys (Optional: Tavily, Serper, or Brave)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=

# Security
CORS_ALLOWED_ORIGINS=http://localhost:8787,chrome-extension://*
RATE_LIMIT_PER_MINUTE=120

# Course Notes Postgres/pgvector (used by docker compose)
POSTGRES_DB=examassist
POSTGRES_USER=examassist
POSTGRES_PASSWORD=local-dev-only
KB_MAX_UPLOAD_BYTES=10485760
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Compose runs a restricted Docker sandbox for code, math, and SQL tools.
SANDBOX_TIMEOUT_MS=2000

# Tool-calling agent budget (required to enforce the USD budget when f_agent is enabled)
# The native tool-calling evaluation requires a configured provider cost so it
# can stop before this per-request USD limit. Leave the cost blank to use the
# deterministic static-pipeline fallback.
AGENT_MAX_USD=0.05
AGENT_COST_PER_1K_TOKENS_USD=
