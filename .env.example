# ==========================================
# ExamAssist AI Root & Docker Compose Config
# ==========================================

PORT=8787
EXAMASSIST_HOST_PORT=8787
NODE_ENV=development

# OpenAI / Compatible LLM API Key (Required for AI features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Web Search Provider Keys (Optional: Tavily, Serper, or Brave)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# Security & Rate Limiting
CORS_ALLOWED_ORIGINS=http://localhost:8787,chrome-extension://*
RATE_LIMIT_PER_MINUTE=120

# Course Notes & Official Docs RAG (Postgres/pgvector)
POSTGRES_DB=examassist
POSTGRES_USER=examassist
POSTGRES_PASSWORD=local-dev-only
KB_MAX_UPLOAD_BYTES=10485760
DOCS_RAG_MIN_SCORE=0.18
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Isolated Sandbox & BullMQ/Redis Execution Queue
SANDBOX_TIMEOUT_MS=2000
SANDBOX_RUNTIME=runc
REDIS_URL=redis://redis:6379

# Optional Multi-Dialect SQL Engines
SQL_POSTGRES_ENABLED=false
SQL_MYSQL_ENABLED=false
MYSQL_ROOT_PASSWORD=local-sandbox-only

# Tool-Calling Agent Budget (f_agent flag)
AGENT_MAX_USD=0.05
AGENT_COST_PER_1K_TOKENS_USD=

# Observability (OpenTelemetry & Langfuse; code/questions redacted by default)
OTEL_REDACT_CODE_AND_QUESTIONS=true
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
