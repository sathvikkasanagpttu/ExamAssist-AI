{
  "name": "examai-study-assistant-monorepo",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "npm run version:check && npm --prefix server run lint && npm --prefix extension run lint",
    "typecheck": "npm --prefix extension run typecheck",
    "test": "npm --prefix server test && npm --prefix extension test",
    "test:e2e": "npm --prefix extension run test:e2e",
    "build": "npm --prefix extension run build",
    "pack": "npm --prefix server run pack",
    "pack:extension": "node scripts/pack-extension.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "docs:verify": "node scripts/verify-docs.mjs",
    "version:check": "node scripts/sync-versions.mjs --check",
    "version:sync": "node scripts/sync-versions.mjs"
  }
}
