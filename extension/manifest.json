{
  "manifest_version": 3,
  "name": "ExamAssist AI — Study & Assessment Copilot",
  "version": "2.3.0",
  "description": "An evidence-first academic study assistant that captures questions and options, researches verified sources, and displays answers directly on assessment pages.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "analyze_question": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Analyze selected question with ExamAssist AI"
    }
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ExamAssist AI Copilot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.hackerrank.com/*",
        "https://leetcode.com/*",
        "https://*.leetcode.com/*",
        "https://*.geeksforgeeks.org/*",
        "https://*.instructure.com/*"
      ],
      "js": [
        "extractors/BaseExtractor.js",
        "extractors/EditorAdapters.js",
        "extractors/ProblemAdapters.js",
        "extractors/GenericExtractor.js",
        "extractors/MoodleAdapter.js",
        "extractors/CanvasAdapter.js",
        "extractors/CustomPortalAdapter.js",
        "extractors/ExtractionManager.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
