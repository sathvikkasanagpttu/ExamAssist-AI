# ==========================================
# ExamAssist AI Backend Configuration
# ==========================================

# Server Listening Port
PORT=8787
HOST=127.0.0.1

# Node Environment (development | production | test)
NODE_ENV=development

# LLM Configuration (Required for AI reasoning)
# Strong reasoning model default: gpt-4o (or o3-mini / o1 / gpt-4.5-preview)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Web Search Providers (Optional)
# If unconfigured, ExamAssist queries Wikipedia for definitional questions only.
# Supported search keys:
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY is also accepted as an alias for BRAVE_SEARCH_API_KEY
# BRAVE_API_KEY=

# Security & Network Controls
CORS_ALLOWED_ORIGINS=http://localhost:8787,chrome-extension://*
RATE_LIMIT_PER_MINUTE=120

# Optional Course Notes storage; leave unset to run with ragEnabled:false
KB_DATABASE_URL=postgresql://examassist:local-dev-only@localhost:5432/examassist
KB_MAX_UPLOAD_BYTES=10485760
KB_MIN_RELEVANCE_RRF=0.014
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
