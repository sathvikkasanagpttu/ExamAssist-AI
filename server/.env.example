# ==========================================
# ExamAssist AI Backend Configuration
# ==========================================

# Server Listening Port & Host
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# LLM Configuration (Required for AI reasoning)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Web Search Providers (Optional: Tavily, Serper, or Brave)
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
# BRAVE_API_KEY=

# Security & Network Controls
CORS_ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787,chrome-extension://*,https://*.leetcode.com,https://*.hackerrank.com,https://*.geeksforgeeks.org,https://*.instructure.com
RATE_LIMIT_PER_MINUTE=120

# Course Notes & Official Docs RAG (Postgres/pgvector; optional)
KB_DATABASE_URL=postgresql://examassist:local-dev-only@localhost:5432/examassist
KB_MAX_UPLOAD_BYTES=10485760
KB_MIN_RELEVANCE_RRF=0.014
DOCS_RAG_MIN_SCORE=0.18
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Isolated Execution Sandbox & BullMQ/Redis Job Queue
SANDBOX_URL=http://127.0.0.1:8790
SANDBOX_TIMEOUT_MS=2000
SANDBOX_RUNTIME=runc
REDIS_URL=redis://127.0.0.1:6379
SANDBOX_USER_CONCURRENCY=2
SANDBOX_QUEUE_TIMEOUT_MS=8000

# Optional Multi-Dialect SQL Sandboxes (PostgreSQL & MySQL behind flags)
SQL_POSTGRES_ENABLED=false
POSTGRES_SQL_SANDBOX_URL=
SQL_MYSQL_ENABLED=false
MYSQL_SQL_SANDBOX_URL=

# Tool-Calling Agent Budget (f_agent flag; defaults off unless budget & cost configured)
AGENT_MAX_USD=0.05
AGENT_COST_PER_1K_TOKENS_USD=

# Semantic Verification Cache (defaults off; caches verified HIGH/MEDIUM results only)
ENABLE_SEMANTIC_CACHE=false

# OpenTelemetry & Langfuse Observability (code/question text redacted by default)
OTEL_REDACT_CODE_AND_QUESTIONS=true
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
