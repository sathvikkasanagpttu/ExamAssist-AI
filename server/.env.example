# ==========================================
# ExamAssist AI Backend Configuration
# ==========================================

# Server Listening Port
PORT=8787

# Node Environment (development | production | test)
NODE_ENV=development

# LLM Configuration (OpenAI, Compatible APIs, or Local Providers)
# Leave unconfigured to use internal fallback reasoning heuristics
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Web Search Providers (Optional)
# If unconfigured, ExamAssist automatically queries public open-access endpoints
# (CrossRef, Wikipedia Academic, and Public Research Repositories)
TAVILY_API_KEY=replace_me
SERPER_API_KEY=replace_me
BRAVE_API_KEY=replace_me

# Security & Network Controls
CORS_ALLOWED_ORIGINS=http://localhost:8787,chrome-extension://*
RATE_LIMIT_PER_MINUTE=120
